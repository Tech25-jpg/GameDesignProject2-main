/// @desc NPC Dialogue
event_inherited();
turns_to_face = true;
text = [
	"Welcome to Royal Time Casino! I would know that because I'm here to tell you! Wa-ha-ha-ha-ha!",
	"Anyway, care to try your luck? Well... You're out of luck! This is early development, for Pete's sake!",
	"However, I pity such a rambunctious whippersnapper in these trying times. Tell you what: before I send you away, how about answering an honest question I have in mind?",
	"Do you enjoy turn-based battles?"
	];
	
image_speed = 0;
image_index = 0;

choice_line = 3;

yes_text = [
	"Splendid! I do too!",
	"Originally, I was going to challenge you to a card battle but due to the time crunch of the first state of play, it won't be possible.",
	"And, sorry to disappoint, by the time of the completed version this area will be long gone and I will too.",
	"But still, we hope Team TASK shan't disappoint you whoever you are behind the screen.",
	"In the meantime, I hope you have a splendid day! Eat well, sleep well, and play well!"
	];
no_text = [
	"Hmph. That's a shame. Well, waiting in line isn't for everyone. Perhaps you're into survival games? open-world? PvP? Everyone has distinct taste that sets us apart. Genres are like food, you have to try them before you like them!"
	];